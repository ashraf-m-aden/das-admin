# Modele de configuration locale. Copier en `.env` et renseigner.
#
#   cp .env.example .env
#
# `.env` est ignore par git et ne doit JAMAIS y revenir : ce depot est PUBLIC
# sur GitHub. Une valeur posee ici est publiee, et l'historique la garde — la
# retirer d'un commit ulterieur ne desexpose rien, il faut TOURNER le secret.
#
# Ce fichier-ci, lui, est suivi : il ne contient aucune valeur, seulement la
# liste de ce qu'il faut poser. C'est lui qui dit au suivant de quoi la pile a
# besoin pour tourner.

# --- Base de donnees --------------------------------------------------------
# L'hote RDS, et le role LECTURE SEULE dont Martin se sert.
RDS_HOST=
RDS_USER=
RDS_PASSWORD=
RDS_DB=

# Chaine de connexion du back .NET. Compte a privileges : ne jamais la coller
# dans un ticket ni dans une capture.
DB_CONNECTION=

# Martin ne lit plus cette variable : `docker-compose.yml` compose son
# DATABASE_URL a partir de RDS_USER / RDS_PASSWORD / RDS_HOST / RDS_DB, comme le
# fait l'EC2. Gardee pour l'outillage qui s'en sert encore (scripts/sig).
#
# ⚠️ La composition vise desormais RDS EN DIRECT, plus le tunnel SSH. C'est ce
# que fait la production, et c'est ce qui evite la panne qui est revenue trois
# fois : un tunnel ouvert en `-L 5433:` ne se lie qu'a 127.0.0.1, le conteneur
# recoit « Connection refused », Martin redemarre en boucle. Si tu as besoin du
# tunnel sur un poste, ouvre-le sur toutes les interfaces
# (`ssh -L 0.0.0.0:5433:<hote-rds>:5432 <bastion>`) et surcharge RDS_HOST.
MARTIN_DATABASE_URL=

# --- Front ------------------------------------------------------------------
API_BASE_URL=/api
MAP_TILE_URL=/api/tiles
MAP_PUBLIC_TILE_URL=/api/public/tiles

# Cle de la carte publique, delivree depuis l'ecran /cles-api. Publique par
# nature : elle voyage dans les URL de tuiles. Ce qu'elle apporte est la
# revocabilite, pas le secret.
MAP_PUBLIC_KEY=

APP_ENVIRONMENT=production
USE_MOCK_API=false

# --- Back-end .NET ----------------------------------------------------------
#
# ⚠️ CLE DE SIGNATURE DES JETONS DE SESSION. Une valeur devinable rend les
# jetons FORGEABLES : un jeton admin fabrique hors de chez nous passe toutes les
# verifications, sans qu'aucun journal ne s'en etonne. Ne JAMAIS y laisser le
# gabarit livre avec le projet : il est
# public par construction : il est ecrit dans les fichiers de configuration par
# defaut du projet, donc connu de quiconque a lu le depot du back.
#
#   openssl rand -base64 48
#
# 32 caracteres minimum, tires au hasard, differents par environnement.
JWT_SECRET=

# Identifiants AWS, lus par le back au demarrage pour Secrets Manager. Sans eux
# il s'arrete avant d'ecouter.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Plateforme 1 de La Poste, hebergee sur ce meme EC2 pour l'instant -------
#
# ⚠️ Nommee `LAPOSTE_DAS_KEY` et pas `DAS_KEY` : ici, D.A.S ne presente pas de
# cle a lui-meme. Celle-ci appartient a un CONSOMMATEUR qu'on heberge, et c'est
# une cle de RECETTE — distincte de celle de leur production.
LAPOSTE_DAS_KEY=

# Port d'ecoute de la Plateforme 1 sur l'hote. 80 est pris par `das-admin`.
# L'EC2 fait foi : 81. 80 est pris par `das-admin`, et 8080 est un port dispute
# qui est deja occupe sur au moins un poste de developpement.
LAPOSTE_PORT=81
