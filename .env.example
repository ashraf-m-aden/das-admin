# Modele de configuration locale. Copier en `.env` et renseigner.
#
#   cp .env.example .env
#
# `.env` est ignore par git et ne doit JAMAIS y revenir : ce depot est PUBLIC
# sur GitHub. Une valeur posee ici est publiee, et l'historique la garde — la
# retirer d'un commit ulterieur ne desexpose rien, il faut TOURNER le secret.
#
# Ce fichier-ci, lui, est suivi : il ne contient aucune valeur, seulement la
# liste de ce qu'il faut poser. C'est lui qui dit au suivant de quoi la pile a
# besoin pour tourner.

# --- Base de donnees --------------------------------------------------------
# L'hote RDS, et le role LECTURE SEULE dont Martin se sert.
RDS_HOST=
RDS_USER=
RDS_PASSWORD=
RDS_DB=

# Chaine de connexion du back .NET. Compte a privileges : ne jamais la coller
# dans un ticket ni dans une capture.
DB_CONNECTION=

# Martin. En developpement, elle vise le tunnel SSH plutot que RDS en direct.
#
# ⚠️ Ouvrir le tunnel sur TOUTES les interfaces, pas seulement 127.0.0.1 :
#   ssh -L 0.0.0.0:5433:<hote-rds>:5432 <bastion>
# Lie a la seule boucle locale, le conteneur recoit « Connection refused » et
# Martin redemarre en boucle. Constate le 2026-09-09, puis deux fois de suite
# le 2026-09-13.
MARTIN_DATABASE_URL=

# --- Front ------------------------------------------------------------------
API_BASE_URL=/api
MAP_TILE_URL=/api/tiles
MAP_PUBLIC_TILE_URL=/api/public/tiles

# Cle de la carte publique, delivree depuis l'ecran /cles-api. Publique par
# nature : elle voyage dans les URL de tuiles. Ce qu'elle apporte est la
# revocabilite, pas le secret.
MAP_PUBLIC_KEY=

APP_ENVIRONMENT=production
USE_MOCK_API=false

# --- Plateforme 1 de La Poste, hebergee sur ce meme EC2 pour l'instant -------
#
# ⚠️ Nommee `LAPOSTE_DAS_KEY` et pas `DAS_KEY` : ici, D.A.S ne presente pas de
# cle a lui-meme. Celle-ci appartient a un CONSOMMATEUR qu'on heberge, et c'est
# une cle de RECETTE — distincte de celle de leur production.
LAPOSTE_DAS_KEY=

# Port d'ecoute de la Plateforme 1 sur l'hote. 80 est pris par `das-admin`.
LAPOSTE_PORT=8080
