{
  "version": 8,
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "https://tiles.basemaps.cartocdn.com/vector/carto.streets/v1/tiles.json",
      "attribution": "&copy; <a href=\"https://carto.com/attributions\">CARTO</a>, &copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
    },
    "blocs": {
      "type": "vector",
      "tiles": ["__TILES_BASE_URL__/blocs_tiles/{z}/{x}/{y}"],
      "promoteId": "Id"
    },
    "adresses": {
      "type": "vector",
      "tiles": ["__TILES_BASE_URL__/adresses_tiles/{z}/{x}/{y}"],
      "promoteId": "Id"
    }
  },
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#f8f9fa" } },

    {
      "id": "basemap-road-minor-case",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "match",
        ["get", "class"],
        ["secondary", "tertiary", "minor", "service"],
        true,
        false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#d7dbe0",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 13, 1.2, 15, 3, 17, 8, 19, 18]
      }
    },
    {
      "id": "basemap-road-minor-fill",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "match",
        ["get", "class"],
        ["secondary", "tertiary", "minor", "service"],
        true,
        false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 13, 0.4, 15, 1.8, 17, 6, 19, 15]
      }
    },

    {
      "id": "basemap-road-major-case",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "match",
        ["get", "class"],
        ["motorway", "trunk", "primary"],
        true,
        false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#c8ced6",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 9, 1.4, 12, 3, 15, 7, 17, 13, 19, 24]
      }
    },
    {
      "id": "basemap-road-major-fill",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "match",
        ["get", "class"],
        ["motorway", "trunk", "primary"],
        true,
        false
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 9, 0.6, 12, 1.8, 15, 5, 17, 10, 19, 20]
      }
    },

    {
      "id": "blocs-fill",
      "type": "fill",
      "source": "blocs",
      "source-layer": "blocs_tiles",
      "paint": {
        "fill-color": [
          "case",
          ["!=", ["feature-state", "colorOverride"], null],
          ["feature-state", "colorOverride"],
          [
            "match",
            ["get", "status"],
            "not_assigned",
            "#9aa3b5",
            "assigned",
            "#2563eb",
            "in_progress",
            "#d97706",
            "submitted",
            "#7c3aed",
            "approved",
            "#16a34a",
            "needs_redo",
            "#dc2626",
            "#dceaf7"
          ]
        ],
        "fill-opacity": [
          "case",
          ["boolean", ["feature-state", "hidden"], false],
          0,
          ["boolean", ["feature-state", "selected"], false],
          0.6,
          0.4
        ]
      }
    },

    {
      "id": "blocs-line",
      "type": "line",
      "source": "blocs",
      "source-layer": "blocs_tiles",
      "paint": {
        "line-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false],
          "#1d4ed8",
          "#64748b"
        ],
        "line-width": ["case", ["boolean", ["feature-state", "selected"], false], 2.4, 1]
      }
    },

    {
      "id": "adresses-fill",
      "type": "fill",
      "source": "adresses",
      "source-layer": "adresses_tiles",
      "minzoom": 12,
      "paint": {
        "fill-color": [
          "case",
          ["!=", ["feature-state", "colorOverride"], null],
          ["feature-state", "colorOverride"],
          [
            "match",
            ["get", "workflowStage"],
            "registered",
            "#6b7280",
            "surveyed",
            "#d97706",
            "verified",
            "#16a34a",
            "approved",
            "#0d9488",
            "published",
            "#7c3aed",
            "#2563eb"
          ]
        ],
        "fill-opacity": [
          "case",
          ["boolean", ["feature-state", "hidden"], false],
          0,
          ["boolean", ["feature-state", "selected"], false],
          0.75,
          0.55
        ]
      }
    },

    {
      "id": "adresses-line",
      "type": "line",
      "source": "adresses",
      "source-layer": "adresses_tiles",
      "minzoom": 12,
      "paint": {
        "line-color": [
          "case",
          ["boolean", ["feature-state", "selected"], false],
          "#1d4ed8",
          "#ffffff"
        ],
        "line-width": ["case", ["boolean", ["feature-state", "selected"], false], 2, 1]
      }
    },

    {
      "id": "basemap-roadname",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 250,
        "text-field": ["get", "name"],
        "text-font": ["Montserrat Regular", "Open Sans Regular", "Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 18, 12]
      },
      "paint": {
        "text-color": "#4b5563",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    }
  ]
}
