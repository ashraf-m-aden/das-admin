{
  "version": 8,
  "sources": {
    "das_ilots": { "type": "vector", "tiles": ["__TILES_BASE_URL__/das_ilots/{z}/{x}/{y}"] },
    "das_parcelles": {
      "type": "vector",
      "tiles": ["__TILES_BASE_URL__/das_parcelles/{z}/{x}/{y}"]
    },
    "adresses": { "type": "vector", "tiles": ["__TILES_BASE_URL__/Adresses/{z}/{x}/{y}"] }
  },
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#f8f9fa" } },

    {
      "id": "parcelles-fill",
      "type": "fill",
      "source": "das_parcelles",
      "source-layer": "das_parcelles",
      "minzoom": 15,
      "paint": { "fill-color": "#eaf1f8", "fill-outline-color": "#b8d4f0", "fill-opacity": 0.6 }
    },

    {
      "id": "ilots-fill",
      "type": "fill",
      "source": "das_ilots",
      "source-layer": "das_ilots",
      "paint": { "fill-color": "#dceaf7", "fill-opacity": 0.35 }
    },

    {
      "id": "ilots-line",
      "type": "line",
      "source": "das_ilots",
      "source-layer": "das_ilots",
      "paint": { "line-color": "#5b9bd5", "line-width": 1.2 }
    },

    {
      "id": "parcelles-line",
      "type": "line",
      "source": "das_parcelles",
      "source-layer": "das_parcelles",
      "minzoom": 16,
      "paint": { "line-color": "#8fbce0", "line-width": 0.5 }
    },

    {
      "id": "adresses-circle",
      "type": "circle",
      "source": "adresses",
      "source-layer": "Adresses",
      "minzoom": 16,
      "paint": {
        "circle-color": "#2563eb",
        "circle-radius": 3.5,
        "circle-stroke-color": "#fff",
        "circle-stroke-width": 1
      }
    }
  ]
}
