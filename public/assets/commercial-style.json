{
  "version": 8,
  "name": "D.A.S — carte publique",
  "metadata": {
    "das:role": "Style commercial publie par D.A.S et consomme tel quel par les clients (La Poste, etc.). Le marqueur __TILES_BASE_URL__ est resolu par le client."
  },
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "quartiers": {
      "type": "vector",
      "tiles": [
        "__TILES_BASE_URL__/quartiers_tiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 18
    },
    "streets": {
      "type": "vector",
      "tiles": [
        "__TILES_BASE_URL__/streets_tiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 18
    },
    "adresses": {
      "type": "vector",
      "tiles": [
        "__TILES_BASE_URL__/adresses_tiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 18
    },
    "poi": {
      "type": "vector",
      "tiles": [
        "__TILES_BASE_URL__/poi_sites_tiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 18
    },
    "citiesLabels": {
      "type": "vector",
      "tiles": [
        "__TILES_BASE_URL__/cities_labels_tiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 18
    }
  },
  "layers": [
    {
      "id": "fond",
      "type": "background",
      "paint": {
        "background-color": "#f8f9fa"
      }
    },
    {
      "id": "quartier-fond",
      "type": "fill",
      "source": "quartiers",
      "source-layer": "quartiers_tiles",
      "paint": {
        "fill-color": "#f1f3f4",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "quartier-trait",
      "type": "line",
      "source": "quartiers",
      "source-layer": "quartiers_tiles",
      "paint": {
        "line-color": "#dfe1e5",
        "line-width": 1
      }
    },
    {
      "id": "quartier-survol",
      "type": "fill",
      "source": "quartiers",
      "source-layer": "quartiers_tiles",
      "paint": {
        "fill-color": "#1a73e8",
        "fill-opacity": [
          "case",
          [
            "boolean",
            [
              "feature-state",
              "survol"
            ],
            false
          ],
          0.12,
          0
        ]
      }
    },
    {
      "id": "quartier-survol-trait",
      "type": "line",
      "source": "quartiers",
      "source-layer": "quartiers_tiles",
      "paint": {
        "line-color": "#1a73e8",
        "line-width": [
          "case",
          [
            "boolean",
            [
              "feature-state",
              "survol"
            ],
            false
          ],
          2.5,
          0
        ]
      }
    },
    {
      "id": "bati",
      "type": "fill",
      "source": "adresses",
      "source-layer": "adresses_tiles",
      "minzoom": 15,
      "paint": {
        "fill-color": "#eceff1",
        "fill-outline-color": "#e0e3e6"
      }
    },
    {
      "id": "piste-bord",
      "type": "line",
      "source": "streets",
      "source-layer": "streets_tiles",
      "filter": [
        "==",
        [
          "get",
          "Type"
        ],
        "Piste"
      ],
      "minzoom": 13,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#e6ddcc",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          2,
          18,
          8
        ]
      }
    },
    {
      "id": "piste",
      "type": "line",
      "source": "streets",
      "source-layer": "streets_tiles",
      "filter": [
        "==",
        [
          "get",
          "Type"
        ],
        "Piste"
      ],
      "minzoom": 13,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f6f2ea",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          1,
          18,
          6
        ]
      }
    },
    {
      "id": "rue-bord",
      "type": "line",
      "source": "streets",
      "source-layer": "streets_tiles",
      "filter": [
        "in",
        [
          "get",
          "Type"
        ],
        [
          "literal",
          [
            "Rue",
            "Impasse"
          ]
        ]
      ],
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#e8eaed",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          2,
          18,
          12
        ]
      }
    },
    {
      "id": "rue",
      "type": "line",
      "source": "streets",
      "source-layer": "streets_tiles",
      "filter": [
        "in",
        [
          "get",
          "Type"
        ],
        [
          "literal",
          [
            "Rue",
            "Impasse"
          ]
        ]
      ],
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          1,
          18,
          9
        ]
      }
    },
    {
      "id": "artere-bord",
      "type": "line",
      "source": "streets",
      "source-layer": "streets_tiles",
      "filter": [
        "in",
        [
          "get",
          "Type"
        ],
        [
          "literal",
          [
            "Avenue",
            "Boulevard"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#dadce0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          3,
          18,
          18
        ]
      }
    },
    {
      "id": "artere",
      "type": "line",
      "source": "streets",
      "source-layer": "streets_tiles",
      "filter": [
        "in",
        [
          "get",
          "Type"
        ],
        [
          "literal",
          [
            "Avenue",
            "Boulevard"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          2,
          18,
          14
        ]
      }
    },
    {
      "id": "nationale-bord",
      "type": "line",
      "source": "streets",
      "source-layer": "streets_tiles",
      "filter": [
        "==",
        [
          "get",
          "Type"
        ],
        "Route"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f2c94c",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          2,
          10,
          3.8,
          18,
          18.5
        ]
      }
    },
    {
      "id": "nationale",
      "type": "line",
      "source": "streets",
      "source-layer": "streets_tiles",
      "filter": [
        "==",
        [
          "get",
          "Type"
        ],
        "Route"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#fdd663",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          1,
          10,
          2.6,
          18,
          15
        ]
      }
    },
    {
      "id": "rue-nom",
      "type": "symbol",
      "source": "streets",
      "source-layer": "streets_tiles",
      "minzoom": 14,
      "filter": [
        "has",
        "Name"
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "Name"
        ],
        "text-font": [
          "Montserrat Regular",
          "Open Sans Regular",
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          10,
          18,
          13
        ],
        "text-letter-spacing": 0.02,
        "symbol-spacing": 260
      },
      "paint": {
        "text-color": "#5f6368",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "numero",
      "type": "symbol",
      "source": "adresses",
      "source-layer": "adresses_tiles",
      "minzoom": 17,
      "layout": {
        "text-field": [
          "to-string",
          [
            "get",
            "Numero"
          ]
        ],
        "text-font": [
          "Montserrat Regular",
          "Open Sans Regular",
          "Noto Sans Regular"
        ],
        "text-size": 10
      },
      "paint": {
        "text-color": "#5f6368",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "poi-point",
      "type": "circle",
      "source": "poi",
      "source-layer": "poi_sites_tiles",
      "minzoom": 13,
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          [
            "interpolate",
            [
              "linear"
            ],
            [
              "get",
              "Batiments"
            ],
            1,
            3,
            20,
            7
          ],
          18,
          [
            "interpolate",
            [
              "linear"
            ],
            [
              "get",
              "Batiments"
            ],
            1,
            6,
            20,
            14
          ]
        ],
        "circle-color": "#7b8794",
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 1.5
      }
    },
    {
      "id": "poi-nom",
      "type": "symbol",
      "source": "poi",
      "source-layer": "poi_sites_tiles",
      "minzoom": 15,
      "filter": [
        "has",
        "Nom"
      ],
      "layout": {
        "text-field": [
          "get",
          "Nom"
        ],
        "text-font": [
          "Montserrat Regular",
          "Open Sans Regular",
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-offset": [
          0,
          1.1
        ],
        "text-anchor": "top",
        "text-max-width": 9,
        "text-optional": true
      },
      "paint": {
        "text-color": "#3c4043",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "quartier-nom",
      "type": "symbol",
      "source": "quartiers",
      "source-layer": "quartiers_tiles",
      "minzoom": 11,
      "layout": {
        "text-field": [
          "get",
          "Nom"
        ],
        "text-font": [
          "Montserrat SemiBold",
          "Open Sans Semibold",
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          11,
          16,
          15
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.06,
        "text-max-width": 9
      },
      "paint": {
        "text-color": "#5f6368",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "ville-nom",
      "type": "symbol",
      "source": "citiesLabels",
      "source-layer": "cities_labels_tiles",
      "maxzoom": 12,
      "layout": {
        "text-field": [
          "get",
          "Name"
        ],
        "text-font": [
          "Montserrat SemiBold",
          "Open Sans Semibold",
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          12,
          12,
          18
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#3c4043",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.2
      }
    }
  ]
}
